# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell/script and JS files (avoid CRLF issues on Windows)
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows batch scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Mark lockfile/generated files (improves GitHub diffs and language stats)
package-lock.json linguist-generated=true
